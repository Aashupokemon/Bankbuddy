{
  "expo": {
    "name": "BankBuddy",
    "slug": "bankbuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bankbuddy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["./plugins/withCleartextTraffic", "expo-notifications", ["expo-image-picker", { "cameraPermission": "BankBuddy uses the camera to attach photo evidence to a checklist step." }], "expo-local-authentication"],
    "android": {
      "package": "com.bankbuddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#070c18"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:8787"
    }
  }
}
