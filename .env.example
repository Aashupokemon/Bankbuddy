# Runtime
NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173

# Data layer.
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) file at .data/pg.
# Set it to use a real server, e.g. postgres://bankbuddy:bankbuddy@localhost:5432/bankbuddy
DATABASE_URL=
PGLITE_DIR=.data/pg

# Assistant extraction.
# ASSISTANT_PROVIDER=none keeps the deterministic rule-based extractor only.
ASSISTANT_PROVIDER=none
ASSISTANT_API_KEY=
ASSISTANT_KILL_SWITCH=false

# Reminders
WORKER_POLL_MS=30000
